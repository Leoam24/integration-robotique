<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="yaskawa_hc10">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import yaskawa_hc10 urdf file -->
    <xacro:include filename="$(find mfja_3rd_floor_description)/urdf/yaskawa_hc10.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="yaskawa_hc10.ros2_control.xacro" />


    <xacro:yaskawa_hc10_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
